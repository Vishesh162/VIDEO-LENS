# Server-side secrets. Never use NEXT_PUBLIC_ for provider keys.
GROQ_API_KEY=
# Notes/chat: any provider exposing an OpenAI-compatible chat completions API.
# Set all three to the key, model ID, and base URL supplied by that provider.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
SARVAM_API_KEY=
WHISPER_PROVIDER=groq
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
RAG_BACKEND=memory
SESSION_TTL_SECONDS=3600
# Optional comma-separated frontend URLs if frontend and API are hosted separately.
ALLOWED_ORIGINS=
